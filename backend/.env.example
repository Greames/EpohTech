# Copy to .env for local development. Do not commit real values.

# --- Required ---
# MongoDB connection string (e.g. from MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net)
MONGO_URL=mongodb://localhost:27017
# Database name to use on that Mongo connection
DB_NAME=anvaya_partners

# --- CORS ---
# Comma-separated list of allowed frontend origins, e.g. https://anvaya-partners.netlify.app
CORS_ORIGINS=*

# --- Admin ---
# Comma-separated emails treated as platform admins
ADMIN_EMAILS=

# --- Emergent integrations (object storage, AI features) ---
# Required for file storage / AI-assisted features to keep working.
EMERGENT_LLM_KEY=
# Only override if you're not using Emergent's hosted integration proxy.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com

# --- Email notifications ---
EMERGENT_EMAIL_KEY=
OWNER_NOTIFY_EMAIL=
EMAIL_FROM_NAME=Anvaya Partners
EMAIL_REPLY_TO=
